---
import type { Lang } from '@/domain/lang';
import VisuallyHidden from '@/components/ui/VisuallyHidden.astro';
import { useTranslations } from '@/lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const other: Lang = lang === 'fr' ? 'en' : 'fr';
const t = useTranslations(lang);
const href = Astro.url.pathname.replace(`/${lang}/`, `/${other}/`);
---

<a
  href={href}
  hreflang={other}
  lang={other}
  data-lang-switch={other}
  class="border-control hover:border-accent hover:text-accent inline-flex min-h-(--pp-size-control-height) min-w-(--pp-size-control-height) items-center justify-center rounded-control border px-2 text-sm font-semibold no-underline transition-colors duration-(--pp-duration-base)"
>
  <!--
    Code affiché en capitales dans le texte (aucun text-transform, ADR-0012). Nom accessible
    « en English » inchangé : il commence par le texte visible, à la casse près (WCAG 2.5.3).
  -->
  <span aria-hidden="true">{other.toUpperCase()}</span>
  <VisuallyHidden>{`${other} ${t(`lang.${other}`)}`}</VisuallyHidden>
</a>

<script>
  import { initLangSwitch } from '@/scripts/lang-switch';
  initLangSwitch();
</script>
