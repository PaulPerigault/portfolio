---
import type { Lang } from '@/domain/lang';
import VisuallyHidden from '@/components/ui/VisuallyHidden.astro';
import { useTranslations } from '@/lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const other: Lang = lang === 'fr' ? 'en' : 'fr';
const t = useTranslations(lang);
const href = Astro.url.pathname.replace(`/${lang}/`, `/${other}/`);
---

<a
  href={href}
  hreflang={other}
  lang={other}
  data-lang-switch={other}
  class="border-control hover:border-accent hover:text-accent inline-flex min-h-(--pp-size-control-height) min-w-(--pp-size-control-height) items-center justify-center rounded-control border px-2 text-sm font-semibold uppercase no-underline transition-colors duration-(--pp-duration-base)"
>
  <!-- Nom accessible « en English » : il commence par le texte visible (WCAG 2.5.3). -->
  <span>{other}</span>
  <VisuallyHidden>{t(`lang.${other}`)}</VisuallyHidden>
</a>

<script>
  import { initLangSwitch } from '@/scripts/lang-switch';
  initLangSwitch();
</script>
