---
import Container from '@/components/ui/Container.astro';
import Heading from '@/components/ui/Heading.astro';
import type { Lang } from '@/domain/lang';
import type { LegalDocument } from '@/domain/legal';
import { fillPlaceholders } from '@/lib/placeholders';
import { SITE } from '@/config/site';
import { useTranslations } from '@/lib/i18n';

interface Props {
  lang: Lang;
  document: LegalDocument;
}

const { lang, document } = Astro.props;
const t = useTranslations(lang);
const values = { email: SITE.email, domain: SITE.domain };
---

<article class="py-section">
  <Container>
    <header class="max-w-prose">
      <p class="text-muted text-sm">{t('footer.legal')}</p>
      <Heading level={1} size="2xl" class="mt-3">
        {document.title}
      </Heading>
      <p class="text-muted mt-3 text-sm">{document.updated}</p>
    </header>
    <div class="mt-12">
      {document.sections.map((section) => (
        <section
          aria-labelledby={`${section.id}-title`}
          class="border-line grid gap-4 border-t py-8 md:grid-cols-[13rem_1fr] md:gap-12"
        >
          <Heading level={2} size="lg" id={`${section.id}-title`} class="md:sticky md:top-24 md:self-start">
            {section.title}
          </Heading>
          <div class="max-w-prose space-y-4">
            {section.paragraphs.map((paragraph) => (
              <p>{fillPlaceholders(paragraph, values)}</p>
            ))}
          </div>
        </section>
      ))}
    </div>
  </Container>
</article>
