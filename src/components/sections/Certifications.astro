---
import Section from '@/components/ui/Section.astro';
import type { Certification } from '@/domain/certification';
import type { Lang } from '@/domain/lang';
import { certificationsNewestFirst } from '@/lib/chronology';
import { formatYearMonth } from '@/lib/format-date';
import { useTranslations } from '@/lib/i18n';
import { SEPARATOR } from '@/lib/typography';

interface Props {
  lang: Lang;
  items: readonly Certification[];
}

const { lang, items } = Astro.props;
const t = useTranslations(lang);
---

<Section id="certifications" title={t('certifications.title')}>
  <ul class="divide-line divide-y">
    {certificationsNewestFirst(items).map((cert) => (
      <li class="gap-3xs sm:gap-x-m py-s flex flex-col first:pt-0 last:pb-0 sm:flex-row sm:flex-wrap sm:items-baseline sm:justify-between">
        <div>
          <p class="font-semibold">{cert.name}</p>
          <p class="text-muted">{cert.issuer}</p>
        </div>
        <p class="text-muted text-sm tabular-nums">
          {cert.inProgress ? (
            t('certifications.in_progress')
          ) : (
            <>
              {cert.dateIssued && (
                <time datetime={cert.dateIssued}>{formatYearMonth(cert.dateIssued, lang)}</time>
              )}
              {cert.dateExpires && (
                <span>
                  {SEPARATOR}
                  {t('certifications.expires')}{' '}
                  <time datetime={cert.dateExpires}>{formatYearMonth(cert.dateExpires, lang)}</time>
                </span>
              )}
            </>
          )}
        </p>
      </li>
    ))}
  </ul>
</Section>
