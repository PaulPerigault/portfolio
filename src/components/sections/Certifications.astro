---
import CertificationPath from '@/components/interactive/CertificationPath.astro';
import Section from '@/components/ui/Section.astro';
import type { CertificationPath as Path } from '@/domain/certification';
import type { Lang } from '@/domain/lang';
import { useTranslations } from '@/lib/i18n';

interface Props {
  lang: Lang;
  path: Path;
}

const { lang, path } = Astro.props;
const t = useTranslations(lang);
---

<Section id="certifications" title={t('certifications.title')}>
  <CertificationPath lang={lang} path={path} />
</Section>
