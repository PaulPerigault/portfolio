---
import Section from '@/components/ui/Section.astro';
import type { Lang } from '@/domain/lang';
import type { SkillCategory } from '@/domain/skill';
import { useTranslations } from '@/lib/i18n';
import { SEPARATOR } from '@/lib/typography';

interface Props {
  lang: Lang;
  categories: readonly SkillCategory[];
}

const { lang, categories } = Astro.props;
const t = useTranslations(lang);
---

<Section id="skills" title={t('skills.title')}>
  <dl class="divide-line border-line bg-surface rounded-surface divide-y border px-5 sm:px-6">
    {categories.map(({ category, items }) => (
      <div class="grid gap-1 py-4 sm:grid-cols-[11rem_1fr] sm:gap-6">
        <dt class="text-fg text-base font-semibold">{category}</dt>
        <dd class="text-fg">{items.join(SEPARATOR)}</dd>
      </div>
    ))}
  </dl>
</Section>
