---
/**
 * Champ de formulaire accessible : libellé et structure du `Field` du design system, message
 * d'erreur relié par `aria-describedby` (vide et masqué tant qu'il n'y a pas d'erreur ; rempli par
 * le script). Les contrôles restent natifs : `Input` et `Textarea` du design system n'acceptent
 * pas `maxlength`, dont dépendent la limite de saisie et `validity.tooLong`.
 */
import Field from '@paulperigault/astro/Field.astro';
interface Props {
  id: string;
  name: string;
  label: string;
  type?: 'text' | 'email' | 'textarea';
  maxlength: number;
  autocomplete?: string;
  required?: boolean;
  rows?: number;
}

const DEFAULT_ROWS = 6;
const {
  id,
  name,
  label,
  type = 'text',
  maxlength,
  autocomplete,
  required = true,
  rows = DEFAULT_ROWS,
} = Astro.props;
const errorId = `${id}-error`;
const control =
  'border-control bg-bg text-fg aria-invalid:border-fg min-h-(--pp-size-control-height) w-full rounded-control border px-3 py-2 text-base aria-invalid:border-2';
---

<Field {id} {label}>
  {type === 'textarea' ? (
    <textarea
      {id}
      {name}
      {maxlength}
      {rows}
      {required}
      aria-describedby={errorId}
      class:list={[control, 'resize-y']}
    />
  ) : (
    <input
      {id}
      {name}
      {type}
      {maxlength}
      {autocomplete}
      {required}
      aria-describedby={errorId}
      class={control}
    />
  )}
  <p id={errorId} class="text-sm font-medium" data-field-error hidden></p>
</Field>
