---
interface Props {
  as?: 'div' | 'li' | 'article';
  /** Surface à filet et rayon `surface`, sans ombre ; bordure d'accent au survol/focus interne si elle contient un lien. */
  interactive?: boolean;
  class?: string;
}

const { as: Tag = 'div', interactive = false, class: className } = Astro.props;
---

<Tag
  class:list={[
    'border-line bg-surface rounded-surface border p-5 transition-colors duration-(--pp-duration-base) sm:p-6',
    interactive && 'hover:border-accent focus-within:border-accent',
    className,
  ]}
>
  <slot />
</Tag>
