---
import Heading from './Heading.astro';

interface Props {
  title: string;
  subtitle?: string;
  /** Période affichée, déjà formatée et localisée. */
  period: string;
  /** Début au format machine (`YYYY-MM`) pour <time datetime>. */
  dateTime?: string;
}

const { title, subtitle, period, dateTime } = Astro.props;
---

<li class="py-m first:pt-0 last:pb-0">
  <div class="gap-3xs sm:gap-x-m flex flex-col sm:flex-row sm:flex-wrap sm:items-baseline sm:justify-between">
    <Heading level={3}>{title}</Heading>
    <p class="text-muted text-sm tabular-nums">
      <time datetime={dateTime}>{period}</time>
    </p>
  </div>
  {subtitle && <p class="text-muted mt-3xs">{subtitle}</p>}
  <div class="mt-xs max-w-measure">
    <slot />
  </div>
</li>
